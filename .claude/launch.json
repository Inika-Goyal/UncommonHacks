{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "next-dev-live",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "NEXT_PUBLIC_DEMO_MODE=false pnpm dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "next-dev-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "pnpm dev --port 3100"],
      "port": 3100,
      "autoPort": false
    }
  ]
}
