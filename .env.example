NEXT_PUBLIC_DEMO_MODE=true

# Required when NEXT_PUBLIC_DEMO_MODE is not true.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required for the live agent swarm. Demo mode does not call OpenAI.
OPENAI_API_KEY=
# Optional model overrides; defaults are gpt-4o-mini (extraction) and gpt-4o (synthesis).
OPENAI_EXTRACTION_MODEL=
OPENAI_SYNTHESIS_MODEL=
# Optional: set to "prefer" to use fresh source-cache rows before live source requests.
# By default, live swarm runs attempt live source requests first and use cache only as fallback.
AGENT_SOURCE_CACHE=

# Required for the report-aware ElevenLabs voice agent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional stretch credentials. Each agent runs against public endpoints when missing.
# Supplier agent uses Wikidata SPARQL (no key required) plus a curated registry.
COURTLISTENER_API_TOKEN=
